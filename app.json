{
  "expo": {
    "name": "Palma Viva",
    "slug": "palma-viva",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.palmaviva.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF3E7"
      }
    },
    "ios": {
      "bundleIdentifier": "com.palmaviva.app",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#1B4D3E"
        }
      ]
    ]
  }
}
